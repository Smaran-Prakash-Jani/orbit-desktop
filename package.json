{
  "name": "orbit-desktop",
  "version": "0.1.0",
  "description": "Your machine, understood. A glass desktop control center for Linux and Windows.",
  "main": "desktop/main.cjs",
  "author": "Orbit contributors",
  "license": "MIT",
  "homepage": "https://github.com/topics/linux",
  "desktopName": "io.github.orbitdesktop.Orbit.desktop",
  "scripts": {
    "start": "electron .",
    "preview": "node scripts/preview.cjs",
    "test": "node --test test/*.test.cjs",
    "check": "node --check desktop/main.cjs && node --check desktop/metrics.cjs && node --check desktop/storage.cjs && node --check desktop/system-info.cjs && node --check ui/select.js && node --check ui/app.js",
    "test:ui": "node scripts/ui-smoke.cjs && node scripts/refinements-smoke.cjs",
    "test:desktop": "node scripts/desktop-smoke.cjs",
    "build:linux": "electron-builder --linux deb AppImage --x64 --publish never",
    "build:windows": "electron-builder --win portable --x64 --publish never",
    "build:windows:installer": "electron-builder --win nsis --x64 --publish never",
    "build:flatpak": "electron-builder --linux dir --x64 --publish never && node scripts/bundle-flatpak.cjs",
    "bundle:flatpak": "node scripts/bundle-flatpak.cjs",
    "build:dir": "electron-builder --dir --publish never"
  },
  "dependencies": {
    "systeminformation": "5.33.23"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "playwright": "^1.56.0"
  },
  "build": {
    "appId": "io.github.orbitdesktop.Orbit",
    "productName": "Orbit",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "desktop/**/*",
      "ui/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "asar": true,
    "artifactName": "Orbit-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "System",
      "icon": "assets/icon.png",
      "executableName": "orbit",
      "syncDesktopName": true,
      "maintainer": "Orbit contributors <orbit@example.invalid>"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.png",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Orbit-${version}-windows-${arch}-portable.${ext}"
    },
    "nsis": {
      "artifactName": "Orbit-${version}-windows-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "flatpak": {
      "runtimeVersion": "25.08",
      "baseVersion": "25.08",
      "finishArgs": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=ipc",
        "--device=dri",
        "--share=network",
        "--filesystem=home:ro"
      ]
    }
  }
}
